{
  "name": "aidcp-api",
  "version": "0.1.0",
  "private": true,
  "description": "aidcp-api —— 面板 API / 客户鉴权 / 飞书 / 账号主数据（属主库 aidcp_api）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test 'test/**/*.test.ts'",
    "test:acceptance": "tsx --test test/acceptance/*.test.ts",
    "test:pg": "AIDCP_PG_INTEGRATION=1 tsx --test 'test/**/*.integration.test.ts'",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "boundaries:refresh": "tsx test/acceptance/helpers/boundary-record.ts refresh",
    "boundaries:census": "tsx test/acceptance/helpers/boundary-record.ts census",
    "start": "tsx --env-file=.env src/api-service-entry.ts",
    "trigger:like": "tsx src/cli/trigger-like.ts",
    "test:feishu": "tsx --env-file=.env src/cli/test-feishu.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.66.0",
    "aidcp-kernel": "git+ssh://git@github.com/tommax-bai/aidcp-kernel.git#6d8ba992df2c760d412d29f467b9443fbb6ba2a1",
    "aidcp-transport": "git+ssh://git@github.com/tommax-bai/aidcp-transport.git#7d10d2f827a9aec5b55593cbd049ede4ab57c86e",
    "pg": "^8.13.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
